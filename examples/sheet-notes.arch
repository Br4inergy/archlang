# An issued sheet — the SHEET-ANNOTATION example.
#
# A drawing that leaves the office carries more than the plan: a drawing number and a
# revision in the title block, and the general notes every contractor reads first. Both
# are opt-in sheet statements, and both are presentation only — `describe()` and `lint()`
# learn nothing from them:
#
#   title { … number "A-101" revision "B" }   two more title-block rows
#   notes "…"                                 the NOTES table, numbered in source order
plan "Sheet Notes Flat" {
  units mm
  grid 50
  paper A3 landscape
  scale 1:50
  north up
  dims auto all
  schedule rooms
  notes "All dimensions in millimetres. Do not scale from this drawing."
  notes "Check every dimension on site before work starts."
  notes "Room areas are taken to wall centrelines."

  title { project "Sheet Notes Flat" drawn_by "ArchLang" date "2026-10-13" number "A-101" revision "B" }

  # ---- shell -------------------------------------------------------------------
  wall id=shell exterior  thickness 200 { (0,0) (9000,0) (9000,6000) (0,6000) close }
  wall id=w_mid partition thickness 100 { (5000,0) (5000,6000) }
  wall id=w_bed partition thickness 100 { (5000,3000) (9000,3000) }

  # ---- rooms -------------------------------------------------------------------
  room id=r_living at (0,0)    size 5000x6000 label "Living Room" uses living
  room id=r_bed    at (5000,0) size 4000x3000 label "Bedroom" uses bedroom
  room id=r_study  at (5000,3000) size 4000x3000 label "Study" uses office

  # ---- doors -------------------------------------------------------------------
  door id=d_front on shell at 2500 width 1000 hinge left swing in
  door id=d_bed on w_mid at 1500 width 900 hinge right swing out
  door id=d_study sliding on w_mid at 4500 width 900

  # ---- windows -----------------------------------------------------------------
  window on shell at 26000 width 1800
  window on shell at 7000 width 1400
  window on shell at 13500 width 1400
}
