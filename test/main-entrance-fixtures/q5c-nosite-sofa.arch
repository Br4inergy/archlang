  room id=r_util at (9000,0) size 3000x5000 label "Utility" uses utility
  door id=d_b on p1 at 2500 width 900
  door id=d_util at (10500,5000) width 900 wall shell
  door id=d_live at (4500,0) width 900 wall shell
