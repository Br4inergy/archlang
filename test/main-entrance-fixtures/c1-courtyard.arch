plan "Courtyard door" {
  units mm
  grid 100
  north up
  site { street south }
  wall id=shell exterior thickness 200 { (0,0) (10000,0) (10000,3000) (3000,3000) (3000,6000) (10000,6000) (10000,10000) (0,10000) close }
  wall id=p1 partition thickness 100 { (0,3000) (3000,3000) }
  wall id=p2 partition thickness 100 { (0,6000) (3000,6000) }
  room id=r_live at (0,0) size 10000x3000 label "Living" uses living
  room id=r_link at (0,3000) size 3000x3000 label "Gallery" uses circulation
  room id=r_entry at (0,6000) size 10000x4000 label "Entry hall" uses entry
  door id=d_a on p1 at 1500 width 900
  door id=d_b on p2 at 1500 width 900
  door id=d_front at (5000,10000) width 1000 wall shell
  door id=d_court sliding at (6500,3000) width 2400 wall shell
  window id=w1 at (5000,0) width 2000 wall shell
}
