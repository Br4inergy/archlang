plan "Chamfer" {
  units mm
  grid 100
  north up
  site { street north }
  wall id=shell exterior thickness 200 { (0,0) (7000,0) (8000,1000) (8000,5000) (0,5000) close }
  room id=r_live polygon (0,0) (7000,0) (8000,1000) (8000,5000) (0,5000) label "Living" uses living
  door id=d_ch at (7500,500) width 900 wall shell
  door id=d_s at (3000,5000) width 900 wall shell
  window id=w1 at (0,2500) width 1200 wall shell
}
