plan "Balcony sealed" {
  units mm
  grid 100
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=p1 partition thickness 100 { (3000,0) (3000,5000) }
  room id=r_hall at (0,0) size 3000x5000 label "Hall" uses hall
  room id=r_live at (3000,0) size 5000x5000 label "Living" uses living
  door id=d_hl on p1 at 2500 width 900
  door id=d_front at (1500,5000) width 1000 wall shell
  door id=d_bal sliding at (5500,0) width 1600 wall shell
  outdoor balcony at (3000,-1500) size 5000x1500 label "Balcony"
  furniture wardrobe at (3100,1900) size 600x1200 label "Blocker"
  window id=w1 at (7000,5000) width 800 wall shell
}
