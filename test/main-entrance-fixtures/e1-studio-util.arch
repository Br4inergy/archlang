plan "Studio and utility" {
  units mm
  grid 100
  wall id=shell exterior thickness 200 { (0,0) (9000,0) (9000,5000) (0,5000) close }
  wall id=p1 partition thickness 100 { (6000,0) (6000,5000) }
  room id=r_studio at (0,0) size 6000x5000 label "Studio" uses living bedroom
  room id=r_util at (6000,0) size 3000x5000 label "Utility" uses utility
  door id=d_su on p1 at 2500 width 900
  door id=d_front at (3000,5000) width 900 wall shell
  door id=d_util at (7500,5000) width 900 wall shell
  window id=w1 at (3000,0) width 1500 wall shell
  furniture wardrobe at (5000,1500) size 900x2000 label "Blocker"
}
