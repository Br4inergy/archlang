plan "Own door" {
  units mm
  grid 100
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=p1 partition thickness 100 { (3000,0) (3000,5000) }
  room id=r_hall at (0,0) size 3000x5000 label "Hall" uses hall
  room id=r_bed at (3000,0) size 5000x5000 label "Bedroom" uses bedroom
  door id=d_hb on p1 at 2500 width 900
  door id=d_front at (1500,5000) width 1000 wall shell
  door id=d_garden at (5500,0) width 600 wall shell
  furniture wardrobe at (3100,1900) size 600x1200 label "Blocker"
  window id=w1 at (7000,0) width 800 wall shell
}
