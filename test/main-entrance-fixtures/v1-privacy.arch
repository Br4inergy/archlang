plan "Privacy cascade" {
  units mm
  grid 100
  wall id=shell exterior thickness 200 { (0,0) (10000,0) (10000,5000) (0,5000) close }
  wall id=p1 partition thickness 100 { (3000,0) (3000,5000) }
  wall id=p2 partition thickness 100 { (6500,0) (6500,5000) }
  room id=r_hall at (0,0) size 3000x5000 label "Hall" uses hall
  room id=r_bed at (3000,0) size 3500x5000 label "Bedroom" uses bedroom
  room id=r_kit at (6500,0) size 3500x5000 label "Kitchen" uses kitchen
  door id=d_hb on p1 at 2500 width 900
  door id=d_bk on p2 at 2500 width 900
  door id=d_front at (1500,5000) width 900 wall shell
  door id=d_back at (8000,5000) width 1000 wall shell
  window id=w1 at (4500,0) width 1500 wall shell
  window id=w2 at (8000,0) width 1500 wall shell
  furniture bed in r_bed anchor top flush inset 300 size 1500x2000
  furniture kitchen_sink in r_kit anchor top-right flush size 800x600
  furniture stove in r_kit anchor top-left flush size 600x600
}
