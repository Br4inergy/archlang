plan "No basement" {
  units mm
  grid 100
    wall id=shell exterior thickness 200 { (0,0) (12000,0) (12000,5000) (0,5000) close }
    wall id=p1 partition thickness 100 { (3000,0) (3000,5000) }
    wall id=p2 partition thickness 100 { (9000,0) (9000,5000) }
    room id=r_hall at (0,0) size 3000x5000 label "Hall" uses hall
    room id=r_live at (3000,0) size 6000x5000 label "Living" uses living
    room id=r_util at (9000,0) size 3000x5000 label "Utility" uses utility
    door id=d_a on p1 at 2500 width 900
    door id=d_b on p2 at 2500 width 900
    door id=d_front at (1500,5000) width 900 wall shell
    door id=d_util at (10500,5000) width 900 wall shell
    window id=w1 at (6000,0) width 1500 wall shell
    furniture sofa at (3100,1500) size 900x2000 label "Sofa"
}
