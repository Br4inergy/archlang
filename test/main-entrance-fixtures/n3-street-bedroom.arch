plan "Street bedroom" {
  units mm
  grid 100
  north up
  site { street south }
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=p1 partition thickness 100 { (4000,0) (4000,5000) }
  room id=r_live at (0,0) size 4000x5000 label "Living" uses living
  room id=r_bed at (4000,0) size 4000x5000 label "Bedroom" uses bedroom
  door id=d_lb on p1 at 2500 width 900
  door id=d_patio sliding at (2000,0) width 2400 wall shell
  door id=d_street at (6000,5000) width 900 wall shell
  window id=w1 at (6000,0) width 1500 wall shell
}
