plan "Back hall privacy" {
  units mm
  grid 100
  wall id=shell exterior thickness 200 { (0,0) (12000,0) (12000,5000) (0,5000) close }
  wall id=p1 partition thickness 100 { (2000,0) (2000,5000) }
  wall id=p2 partition thickness 100 { (5000,0) (5000,5000) }
  wall id=p3 partition thickness 100 { (9000,0) (9000,5000) }
  room id=r_back at (0,0) size 2000x5000 label "Mud room" uses circulation
  room id=r_bed at (2000,0) size 3000x5000 label "Bedroom" uses bedroom
  room id=r_live at (5000,0) size 4000x5000 label "Living" uses living
  room id=r_kit at (9000,0) size 3000x5000 label "Kitchen" uses kitchen
  door id=d_bb on p1 at 2500 width 900
  door id=d_bl on p2 at 2500 width 900
  door id=d_lk on p3 at 2500 width 900
  door id=d_back at (1000,5000) width 900 wall shell
  door id=d_front at (7000,5000) width 900 wall shell
  window id=w1 at (3500,0) width 1200 wall shell
  window id=w2 at (7000,0) width 1500 wall shell
  window id=w3 at (10500,0) width 1200 wall shell
  furniture bed in r_bed anchor top flush inset 300 size 1500x2000
  furniture kitchen_sink in r_kit anchor top-right flush size 800x600
  furniture stove in r_kit anchor top-left flush size 600x600
}
