# The widening drill done right by hand: every literal the 500 mm widening moves, moved
# (the shell, the partition, the door through it, the window). `widen.arch` with
# `let AW = 4500` must draw exactly this.
plan "widen" {
  units mm
  grid 50
  wall exterior thickness 200 { (0,0) (8500,0) (8500,5000) (0,5000) close }
  wall partition thickness 100 { (4500,0) (4500,5000) }
  room id=a at (0,0) size 4500x5000 label "Living"
  room id=b at (4500,0) size 4000x5000 label "Bed"
  door at (1000, 0) width 900 wall exterior
  door at (4500, 2500) width 800 wall partition
  window at (6500, 0) width 1500 wall exterior
}
