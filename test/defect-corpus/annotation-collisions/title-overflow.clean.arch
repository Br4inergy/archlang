# class: annotation-collisions
# twin-of: title-overflow
# origin: the same sheet with a project value that fits its row
# expect: none
# fact: the 21-character value is about 1000 wide at 0.5 em, so it starts near x 12665, right of the PROJECT caption
#   (x 12135, about 320 wide) and inside the frame
plan "Title that fits" {
  units mm
  grid 50
  paper A3 landscape
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  room id=r at (0,0) size 8000x5000 label "Studio" uses living
  door at (4000,5000) width 900 wall shell
  window at (4000,0) width 1500 wall shell
  title {
    project "742 Evergreen Terrace"
    drawn_by "ArchLang"
  }
}
