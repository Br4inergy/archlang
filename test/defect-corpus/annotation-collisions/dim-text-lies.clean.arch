# class: annotation-collisions
# twin-of: dim-text-lies
# origin: examples/studio.arch top dimensions as shipped
# expect: none
# fact: the dim runs (4000,-100) to (0,-100), a 4000 mm span, and its text says "4000"
plan "Dimension text that agrees" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (7000,0) (7000,6000) (0,6000) close }
  wall id=w_mid partition thickness 100 { (4000,0) (4000,6000) }
  room id=r_living at (0,0) size 4000x6000 label "Living / Kitchen" uses living kitchen
  room id=r_bed at (4000,0) size 3000x6000 label "Bedroom" uses bedroom
  door at (2000,6000) width 900 wall shell
  door at (4000,3000) width 800 wall w_mid
  window at (2000,0) width 1500 wall shell
  window at (5500,0) width 1200 wall shell
  dim (4000,-100)->(0,-100) offset 250 text "4000"
  dim (7000,-100)->(4000,-100) offset 250 text "3000"
}
