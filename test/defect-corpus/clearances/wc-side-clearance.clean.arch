# class: clearances
# twin-of: wc-side-clearance
# origin: audits/showcase-and-examples.md M2 with the wc moved off the side wall
# expect: none
# fact: the wc's centreline is y=2000: 400 mm to the south wall's inner face (2400) and 400 mm to the basin's edge (1600)
plan "WC clear of the side wall" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,2500) (0,2500) close }
  wall id=w_mid partition thickness 100 { (2000,0) (2000,2500) }
  room id=r_bath at (0,0) size 2000x2500 label "Bathroom" uses bath
  room id=r_living at (2000,0) size 4000x2500 label "Living Room" uses living
  door id=d_entry at (4000,2500) width 900 wall shell
  door id=d_bath at (2000,1250) width 700 wall w_mid swing into r_bath
  window at (4000,0) width 1500 wall shell
  furniture wc against wall shell segment 3 offset 500 in r_bath
  furniture basin against wall shell segment 3 offset 1200 in r_bath
}
