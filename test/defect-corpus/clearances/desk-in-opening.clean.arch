# class: clearances
# twin-of: desk-in-opening
# origin: audits/archcanvas-public-examples.md FH3 with the desk moved to the far wall
# expect: none
# fact: the desk spans x 300-1900, y 300-1100, nowhere near the opening at x=5000
plan "Desk clear of an opening" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,4000) (0,4000) close }
  wall id=w_mid partition thickness 100 { (5000,0) (5000,4000) }
  room id=r_study at (0,0) size 5000x4000 label "Study" uses office
  room id=r_entry at (5000,0) size 3000x4000 label "Entry" uses entry
  door id=d_entry at (6500,4000) width 900 wall shell
  opening id=o_study at (5000,2000) width 1200 wall w_mid
  window at (2500,0) width 1500 wall shell
  furniture desk at (300,300) size 1600x800 in r_study
}
