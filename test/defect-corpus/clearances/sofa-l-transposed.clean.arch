# class: clearances
# twin-of: sofa-l-transposed
# origin: audits/2026-10-25-first-contact-rerun-row5.md RK4 with the two sides of `size` swapped
# expect: none
# fact: `size 2400x900` draws the L 2400 along its back and 900 deep, its long side along the back as the catalogue's
#   2600 x 1600 has it (a smaller custom L, not a turned one)
plan "L-sofa written as a transposed footprint" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (5000,0) (5000,4000) (0,4000) close }
  room id=r_liv at (0,0) size 5000x4000 label "Lounge" uses living
  door id=d_entry at (4000,4000) width 900 wall shell
  window at (2500,0) width 1500 wall shell
  furniture tv_unit against wall shell segment 3 offset 2000 in r_liv
  furniture sofa_l at (2000,800) size 2400x900 label "L-sofa"
}
