# class: clearances
# origin: repro/gallery-bench-pinch.arch (Gallery B, its spine opening and f_bench2 only; shifted to x=0)
# expect: W_PATH_TOO_NARROW
# status: done
# fact: o_g2 spans x 1500-4500 on w_spine (gallery face y=4900); the bench spans x 1300-4700, y 4300-4900,
#   against that face across the whole opening
plan "Bench across a gallery opening" {
  units mm
  grid 100
  wall id=shell exterior thickness 300 { (0,0) (6000,0) (6000,7500) (0,7500) close }
  wall id=w_spine partition thickness 200 { (0,5000) (6000,5000) }
  room id=r_g2 at (0,0) size 6000x5000 label "Gallery B"
  room id=r_concourse at (0,5000) size 6000x2500 label "Concourse" uses circulation
  door id=d_main at (3000,7500) width 1200 wall shell swing out
  opening id=o_g2 on w_spine at 3000 width 3000
  furniture id=f_bench2 bench at (1300,4300) size 3400x600 label "Bench" in r_g2
}
