# class: clearances
# origin: audits/archcanvas-public-examples.md SL1 (studio-loft double bed fills the 1800-wide alcove and blocks its only opening; caught)
# expect: W_PATH_TOO_NARROW
# status: done
# fact: the alcove's only opening spans y 2250-3450 on w_alc and the bed covers x 6050-7850, y 1850-3850 right behind it
plan "Bed blocking the alcove" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,4000) (0,4000) close }
  wall id=w_alc partition thickness 100 { (6000,0) (6000,4000) }
  room id=r_loft at (0,0) size 6000x4000 label "Loft" uses living
  room id=r_alcove at (6000,0) size 2000x4000 label "Sleeping Alcove" uses bedroom
  door id=d_entry at (3000,4000) width 900 wall shell
  opening id=o_alcove at (6000,2850) width 1200 wall w_alc
  window at (3000,0) width 2000 wall shell
  window at (8000,1000) width 1000 wall shell
  furniture double_bed at (6050,1850) size 1800x2000 in r_alcove
}
