# class: clearances
# origin: audits/archcanvas-public-examples.md GW3 (gallery-wing bench 400 mm inside Gallery B's 3 m opening; README PS0.8)
# expect: W_PATH_TOO_NARROW
# status: todo
# fact: o_g2 spans x 1500-4500 (gallery face y=4900); the bench spans x 1800-4200, y 3900-4500, so the way past
#   is the 500 mm diagonal from the bench corner (1800,4500) to the jamb corner (1500,4900), and the same at the east end
plan "Bench pinching a gallery opening" {
  units mm
  grid 100
  wall id=shell exterior thickness 300 { (0,0) (6000,0) (6000,7500) (0,7500) close }
  wall id=w_spine partition thickness 200 { (0,5000) (6000,5000) }
  room id=r_g2 at (0,0) size 6000x5000 label "Gallery B"
  room id=r_concourse at (0,5000) size 6000x2500 label "Concourse" uses circulation
  door id=d_main at (3000,7500) width 1200 wall shell swing out
  opening id=o_g2 on w_spine at 3000 width 3000
  furniture id=f_bench2 bench at (1800,3900) size 2400x600 label "Bench" in r_g2
}
