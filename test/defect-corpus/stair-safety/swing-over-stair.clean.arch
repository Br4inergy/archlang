# class: stair-safety
# twin-of: swing-over-stair
# origin: audits/showcase-and-examples.md X5 with the ensuite door swinging into the ensuite
# expect: none
# fact: d_en_corr swings into the ensuite (y 1900-2600), clear of the stair (y 2700-3700)
plan "Door swinging away from the stair head" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,4500) (0,4500) close }
  wall id=w_land partition thickness 100 { (0,2600) (8000,2600) }
  wall id=w_en partition thickness 100 { (3500,0) (3500,2600) }
  room id=r_bed at (0,0) size 3500x2600 label "Bedroom 2" uses bedroom
  room id=r_en at (3500,0) size 4500x2600 label "Ensuite" uses bath
  room id=r_landing at (0,2600) size 8000x1900 label "Landing" uses circulation
  door id=d_front at (1000,4500) width 900 wall shell
  door id=d_bed at (1750,2600) width 800 wall w_land swing into r_bed
  door id=d_en_corr at (4900,2600) width 700 wall w_land hinge near start swing into r_en
  window at (1750,0) width 1200 wall shell
  stair id=stair at (4900,2700) size 2200x1000 dir down
}
