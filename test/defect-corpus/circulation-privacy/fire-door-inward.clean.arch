# class: circulation-privacy
# twin-of: fire-door-inward
# origin: audits/2026-10-18-first-contact.md K1 with the building-relative wording of PS3.8 (`swing outward`)
# expect: none
# fact: the same door written `swing outward` resolves to wall-relative `in` (right of travel, south): its leaf sweeps y
#   4100-5100 outside the building, in the escape direction (Plan JSON `swing` in, `swing_building` outward)
plan "Fire exit opening inward" {
  units mm
  grid 50
  wall id=w_n exterior thickness 200 { (0,0) (6000,0) }
  wall id=w_e exterior thickness 200 { (6000,0) (6000,4000) }
  wall id=w_s exterior thickness 200 { (0,4000) (6000,4000) }
  wall id=w_w exterior thickness 200 { (0,4000) (0,0) }
  wall id=w_p partition thickness 100 { (0,2000) (6000,2000) }
  room id=r_staff at (0,0) size 6000x2000 label "Staff room" uses office
  room id=r_corr at (0,2000) size 6000x2000 label "Rear corridor" uses circulation
  door id=d_staff on w_p at 1500 width 900 swing into r_staff
  door id=d_main sliding on w_w at 1000 width 1200
  door id=d_fire on w_s at 4500 width 1000 swing outward
  window on w_n at 3000 width 1500
}
