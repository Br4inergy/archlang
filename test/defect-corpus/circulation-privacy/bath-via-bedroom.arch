# class: circulation-privacy
# origin: audits/showcase-and-examples.md railroad-apartment ("bath through Bedroom 2", intentional there and caught)
# expect: W_BATH_VIA_BEDROOM
# status: done
# fact: the bathroom's only door opens from Bedroom 2; the living room reaches it only through the bedroom
plan "Bath through a bedroom" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=w_mid partition thickness 100 { (4000,0) (4000,5000) }
  wall id=w_bath partition thickness 100 { (4000,3000) (8000,3000) }
  room id=r_living at (0,0) size 4000x5000 label "Living" uses living
  room id=r_bed2 at (4000,0) size 4000x3000 label "Bedroom 2" uses bedroom
  room id=r_bath at (4000,3000) size 4000x2000 label "Bathroom" uses bath
  door id=d_entry at (2000,5000) width 900 wall shell
  door id=d_living_bed2 at (4000,1500) width 800 wall w_mid
  door id=d_bed2_bath at (6000,3000) width 800 wall w_bath
  window at (2000,0) width 1500 wall shell
  window at (6000,0) width 1200 wall shell
}
