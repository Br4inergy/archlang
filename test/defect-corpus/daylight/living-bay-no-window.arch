# class: daylight
# origin: audits/showcase-and-examples.md X2 (examples/hillside-villa.arch L1: the 28.8 m2 living room's arc bay is solid; only the garden door)
# expect: W_HABITABLE_NO_WINDOW
# status: done
# fact: r_living (uses living, 4.8 x 6 m) has no window; its bowed bay is a solid arc and its only opening is the garden door
plan "Living with a solid bay" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (4800,0) (4800,6000) (4000,6000) arc (1400,6000) radius 2000 cw (0,6000) close }
  room id=r_living at (0,0) size 4800x6000 label "Living" uses living
  door id=d_garden at (700,6000) width 900 wall shell swing out
}
