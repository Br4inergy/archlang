# class: openings-ignore-walls
# twin-of: fa-door-across-tee
# origin: repro/family-apartment.arch d_living_bed3 moved wholly onto Bathroom 2
# expect: none
# fact: d_tee spans y 2800-3600: a 350 mm nib to the p_h face at 2450 and 300 mm to the shell's inner face at 3900
plan "Door clear of a partition tee" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,4000) (0,4000) close }
  wall id=p_v partition thickness 100 { (3000,0) (3000,4000) }
  wall id=p_h partition thickness 100 { (0,2400) (3000,2400) }
  room id=bath1 at (0,0) size 3000x2400 label "Bathroom 1" uses bath
  room id=bath2 at (0,2400) size 3000x1600 label "Bathroom 2" uses bath
  room id=hall at (3000,0) size 3000x4000 label "Hall" uses hall
  door id=d_front on shell at 8000 width 900
  door id=d_bath1 at (3000,1000) width 700 wall p_v
  door id=d_tee at (3000,3200) width 800 wall p_v
}
