# class: openings-ignore-walls
# twin-of: door-on-exterior-tee
# origin: repro/door-on-tee.arch with the door moved off the tee (as repro/door-beside-tee-window-overlap.arch)
# expect: none
# fact: d_front spans x 4150-5050, 100 mm clear of the partition face at 4050; describe reports it as the
#   exterior door of b
plan "Door beside an exterior tee" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=p partition thickness 100 { (4000,0) (4000,5000) }
  room id=a at (0,0) size 4000x5000 label "A"
  room id=b at (4000,0) size 4000x5000 label "B"
  door id=d_front on shell at 4600 width 900
  door on p at 50% width 800
}
