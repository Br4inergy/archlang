# class: openings-ignore-walls
# origin: audits/archcanvas-public-examples.md FH1 (family-house garden bifold x 1000-3400 over win_living)
# expect: W_OPENING_OVERLAP
# status: todo
# fact: on the south run the bifold spans x 1000-3400 and the window x 800-1800: 800 mm of overlap
plan "Bifold over a window" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  room id=a at (0,0) size 8000x5000 label "Living" uses living
  door id=d_garden bifold at (2200,5000) width 2400 wall shell
  window id=win at (1300,5000) width 1000 wall shell
  window at (4000,0) width 1800 wall shell
}
