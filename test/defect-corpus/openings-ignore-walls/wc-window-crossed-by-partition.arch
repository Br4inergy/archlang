# class: openings-ignore-walls
# origin: audits/2026-10-18-first-contact.md C1 (first-contact-plans/4-cafe.arch window_8 x 7100-7700 crossed by w_v3
#   at x 7550-7650)
# expect: W_OPENING_AT_JUNCTION
# status: done
# fact: win_wc spans x 1900-2500 on the north wall and w_v's body x 2350-2450 stands in it: 100 mm of the opening is
#   wall and 50 mm of glazing lights the store
plan "WC window crossed by the WC-store partition" {
  units mm
  grid 50
  wall id=shell exterior thickness 250 { (0,0) (4600,0) (4600,3500) (0,3500) close }
  wall id=w_h partition thickness 100 { (0,2000) (4600,2000) }
  wall id=w_v partition thickness 100 { (2400,0) (2400,2000) }
  room id=r_wc at (0,0) size 2400x2000 label "Staff WC" uses wc
  room id=r_store at (2400,0) size 2200x2000 label "Store" uses storage
  room id=r_hall at (0,2000) size 4600x1500 label "Hall" uses hall
  door id=d_front at (2000,3500) width 900 wall shell
  door id=d_wc at (900,2000) width 800 wall w_h swing into r_wc
  door id=d_store at (3500,2000) width 800 wall w_h swing into r_store
  window id=win_wc at (2200,0) width 600 wall shell
  furniture wc against wall shell segment 3 offset 2700 in r_wc
  furniture basin against wall shell segment 0 offset 1200 in r_wc
}
