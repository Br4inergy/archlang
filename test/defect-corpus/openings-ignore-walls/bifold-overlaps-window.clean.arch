# class: openings-ignore-walls
# twin-of: bifold-overlaps-window
# origin: audits/archcanvas-public-examples.md FH1 with the window moved along the run
# expect: none
# fact: the bifold spans x 1000-3400 and the window x 5500-6500: a 2100 mm pier between them
plan "Bifold beside a window" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  room id=a at (0,0) size 8000x5000 label "Living" uses living
  door id=d_garden bifold at (2200,5000) width 2400 wall shell
  window id=win at (6000,5000) width 1000 wall shell
  window at (4000,0) width 1800 wall shell
}
