# class: openings-ignore-walls
# twin-of: door-notches-tee-wall
# origin: audits/showcase-and-examples.md F1 with the door moved off the party wall
# expect: none
# fact: d_exit spans x 3600-4600: a 250 mm nib to the party wall's west face at 4850
plan "Door clear of a party wall" {
  units mm
  grid 25
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=w_party partition thickness 300 { (5000,0) (5000,5000) }
  room id=a at (0,0) size 5000x5000 label "Stair hall" uses circulation
  room id=b at (5000,0) size 3000x5000 label "Flat" uses living
  door id=d_exit on shell at 4100 width 1000
  door on w_party at 50% width 900
}
