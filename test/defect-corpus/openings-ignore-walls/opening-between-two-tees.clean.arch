# class: openings-ignore-walls
# twin-of: opening-between-two-tees
# origin: audits/showcase-and-examples.md M1 with the opening narrowed
# expect: none
# fact: o_rear spans x 4000-4800 on the spine: 150 mm nibs to the p_west (3850) and p_east (4950) faces
plan "Opening between two tees, with nibs" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (9000,0) (9000,6000) (0,6000) close }
  wall id=p_spine partition thickness 100 { (0,3000) (9000,3000) }
  wall id=p_west partition thickness 100 { (3800,0) (3800,3000) }
  wall id=p_east partition thickness 100 { (5000,0) (5000,3000) }
  room id=r_living at (0,0) size 3800x3000 label "Living" uses living
  room id=r_rear at (3800,0) size 1200x3000 label "Rear hall" uses circulation
  room id=r_kitchen at (5000,0) size 4000x3000 label "Kitchen" uses kitchen
  room id=r_hall at (0,3000) size 9000x3000 label "Hall" uses hall
  door id=d_front on shell at 19500 width 900
  door on p_spine at 1900 width 800
  door on p_spine at 7000 width 800
  opening id=o_rear on p_spine at 4400 width 800
}
