# class: openings-ignore-walls
# origin: audits/showcase-and-examples.md MR1 (miraflores s_vest_w across w_s3); audits/archcanvas-public-examples.md BB2
# expect: W_OPENING_AT_JUNCTION
# status: todo
# fact: win spans x 3500-5500 on the north run; partition p (faces 3950-4050) dead-ends into the glass,
#   leaving 450 mm of glazing in a and 1450 mm in b
plan "Window across a tee" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=p partition thickness 100 { (4000,0) (4000,5000) }
  room id=a at (0,0) size 4000x5000 label "Guard post"
  room id=b at (4000,0) size 4000x5000 label "Vestibule"
  door id=d_front on shell at 19000 width 900
  door on p at 3500 width 800
  window id=win on shell at 4500 width 2000
}
