# class: space-not-enclosed
# origin: audits/archcanvas-public-examples.md GW1, GW2 (gallery-wing partition stopping at the chord of a bowed facade)
# expect: W_FLOOR_UNASSIGNED
# status: done
# fact: the south facade bows out from the chord y=4000 (R9000, chord 10000, sagitta about 1517 mm); both
#   rooms stop at the chord and the partition ends there, so the bow segment (about 10.3 m2) is in no room
#   and joins Shop to Cafe
plan "Partition short of a bowed facade" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (10000,0) (10000,4000) arc (0,4000) radius 9000 cw close }
  wall id=w_s2 partition thickness 100 { (5000,0) (5000,4000) }
  room id=r_shop at (0,0) size 5000x4000 label "Shop" uses storage
  room id=r_cafe at (5000,0) size 5000x4000 label "Cafe" uses dining
  door on shell at 2500 width 1000
  door on shell at 7500 width 1000
}
