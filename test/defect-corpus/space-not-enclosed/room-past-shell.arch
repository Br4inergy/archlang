# class: space-not-enclosed
# origin: evidence.md section 3 class 2 ("a room outside the shell"), the absolute-coordinate form of repro/widen-after.arch
# expect: W_ROOM_OUTSIDE_SHELL
# status: todo
# fact: room b is authored at x 4000-8600, so 600 mm of it lies past the shell's east wall at x=8000
plan "Room drawn past the shell" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=p partition thickness 100 { (4000,0) (4000,5000) }
  room id=a at (0,0) size 4000x5000 label "Living" uses living
  room id=b at (4000,0) size 4600x5000 label "Bedroom" uses bedroom
  door id=d_entry at (2000,5000) width 900 wall shell
  door at (4000,2500) width 800 wall p
  window at (2000,0) width 1500 wall shell
  window at (6000,0) width 1500 wall shell
}
