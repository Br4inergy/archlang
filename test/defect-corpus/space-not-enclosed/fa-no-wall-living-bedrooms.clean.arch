# class: space-not-enclosed
# twin-of: fa-no-wall-living-bedrooms
# origin: repro/family-apartment.arch with the missing wall drawn and a door from the living room to each bedroom
# expect: none
# fact: partition p_living runs the whole y=4000 edge (x 0-6000) with one door into each bedroom
plan "Living walled from two bedrooms" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,7000) (0,7000) close }
  wall id=p_beds partition thickness 100 { (3000,4000) (3000,7000) }
  wall id=p_living partition thickness 100 { (0,4000) (6000,4000) }
  room id=r_living at (0,0) size 6000x4000 label "Living Room" uses living
  room id=r_bed3 at (0,4000) size 3000x3000 label "Bedroom 3" uses bedroom
  room id=r_bed4 at (3000,4000) size 3000x3000 label "Bedroom 4" uses bedroom
  door id=d_entry on shell at 3000 width 900
  door id=d_bed3_bed4 on p_beds at 50% width 800
  door on p_living at 1500 width 800
  door on p_living at 4500 width 800
  window on shell at 8000 width 1200
  window on shell at 4500 width 1200
  window on shell at 17500 width 1200
  window on shell at 14500 width 1200
}
