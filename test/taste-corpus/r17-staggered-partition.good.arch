# criterion: R17
# twin-of: r17-staggered-partition
# origin: the same rooms with the bedrooms' partition moved 600 mm to line up with the living and
#   dining rooms' (Bedroom 1 4000 wide, Bedroom 2 3000)
# fact: x-axes 0, 4000, 7000 and y-axes 0, 3500, 5000, 8500 over 4 rooms: 7/4 = 1.75, R17 = 0.75
plan "R17 aligned partition" {
  units mm
  grid 100
  room id=r_living at (0,0) size 4000x3500 label "Living Room" uses living
  room id=r_dining at (4000,0) size 3000x3500 label "Dining Room" uses dining
  room id=r_hall at (0,3500) size 7000x1500 label "Hall" uses hall
  room id=r_bed1 at (0,5000) size 4000x3500 label "Bedroom 1" uses bedroom
  room id=r_bed2 at (4000,5000) size 3000x3500 label "Bedroom 2" uses bedroom
  walls from rooms exterior 200 partition 100
  door id=d_front on r_hall.left at center width 900 swing into r_hall
  door id=d_living between r_hall and r_living at center width 900 swing into r_living
  door id=d_dining between r_hall and r_dining at center width 900 swing into r_dining
  door id=d_bed1 between r_hall and r_bed1 at center width 900 swing into r_bed1
  door id=d_bed2 between r_hall and r_bed2 at center width 900 swing into r_bed2
  window id=w_living on r_living.top at center width 1800
  window id=w_dining on r_dining.top at center width 1500
  window id=w_bed1 on r_bed1.bottom at center width 1500
  window id=w_bed2 on r_bed2.bottom at center width 1200
}
