# criterion: R16
# twin-of: r16-door-mid-wall
# origin: the same door slid along the shared wall (`at 750 from start`); the design's 100 mm
#   nib would leave the jamb on the exterior wall's face, which the compiler refuses
#   (`E_OPENING_NIB`), so the twin keeps 350 mm
# fact: the nearer jamb is 350 mm from the bedroom's corner, within max(100, 600): R16 = 1/1
plan "R16 corner door" {
  units mm
  grid 100
  room id=r_hall at (0,0) size 2000x3000 label "Hall" uses hall
  room id=r_bed at (2000,0) size 3000x3000 label "Bedroom" uses bedroom
  walls from rooms exterior 200 partition 100
  door id=d_front on r_hall.left at center width 900 swing into r_hall
  door id=d_bed between r_hall and r_bed at 750 from start width 900 swing into r_bed
  window id=w_bed on r_bed.right at center width 1500
}
