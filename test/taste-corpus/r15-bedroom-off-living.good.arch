# criterion: R15
# twin-of: r15-bedroom-off-living
# origin: the same rooms with the second bedroom's door moved from the living room to the hall
# fact: both bedrooms open off the hall: the one bedroom pair is zoned, R15 = 1/1
plan "R15 bedrooms off the hall" {
  units mm
  grid 100
  room id=r_bed2 at (0,0) size 3000x4000 label "Bedroom 2" uses bedroom
  room id=r_living at (3000,0) size 4000x4000 label "Living Room" uses living
  room id=r_bed1 at (7000,0) size 3000x4000 label "Bedroom 1" uses bedroom
  room id=r_hall at (0,4000) size 10000x1500 label "Hall" uses hall
  walls from rooms exterior 200 partition 100
  door id=d_front on r_hall.bottom at center width 900 swing into r_hall
  door id=d_living between r_hall and r_living at center width 900 swing into r_living
  door id=d_bed1 between r_hall and r_bed1 at center width 900 swing into r_bed1
  door id=d_bed2 between r_hall and r_bed2 at center width 900 swing into r_bed2
  window id=w_bed2 on r_bed2.top at center width 1500
  window id=w_living on r_living.top at center width 1800
  window id=w_bed1 on r_bed1.top at center width 1500
}
