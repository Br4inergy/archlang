# criterion: R11
# origin: design 2026-10-24-ps5-taste-design.md §3 R11 (the kitchen-dining link); the kitchen
#   shares a wall with the living room but opens only onto the hall
# fact: no door or opening joins the kitchen to the living room: R11 = 0/1
plan "R11 kitchen off the hall" {
  units mm
  grid 100
  room id=r_hall at (0,0) size 2000x7000 label "Hall" uses hall
  room id=r_living at (2000,0) size 4000x4000 label "Living Room" uses living
  room id=r_kitchen at (2000,4000) size 4000x3000 label "Kitchen" uses kitchen
  walls from rooms exterior 200 partition 100
  door id=d_front on r_hall.left at center width 900 swing into r_hall
  door id=d_living between r_hall and r_living at center width 900 swing into r_living
  door id=d_kitchen between r_hall and r_kitchen at center width 900 swing into r_kitchen
  window id=w_living on r_living.top at center width 1800
  window id=w_kitchen on r_kitchen.bottom at center width 1500
  furniture kitchen_sink against r_kitchen.right offset 600 in r_kitchen
  furniture stove against r_kitchen.right offset 1500 in r_kitchen
  furniture counter against r_kitchen.right offset 2200 in r_kitchen
}
